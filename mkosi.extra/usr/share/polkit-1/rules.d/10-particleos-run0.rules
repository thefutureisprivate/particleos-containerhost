// run0 and system unit management share systemd's manage-units action. Keep
// that authority inside the provisioned wheel account and require its own
// password on each request; the recovery root password is not an alternative.
polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" &&
        action.id !== "org.freedesktop.systemd1.manage-unit-files")
        return polkit.Result.NOT_HANDLED;

    if (subject.user === "root")
        return polkit.Result.YES;
    if (subject.isInGroup("wheel"))
        return polkit.Result.AUTH_SELF;
    return polkit.Result.NO;
});

// For other administrator-authenticated actions, select the invoking wheel
// user's password instead of presenting the recovery root identity.
polkit.addAdminRule(function(action, subject) {
    if (subject.isInGroup("wheel"))
        return ["unix-user:" + subject.user];
    return ["unix-user:0"];
});
