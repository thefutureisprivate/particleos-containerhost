[Unit]
Description=Migrate persistent state to the PCR 7+11 NV policy
Documentation=https://github.com/thefutureisprivate/particleos-containerhost#updates
ConditionSecurity=measured-uki
ConditionPathExists=/dev/tpmrm0
ConditionPathExists=!/var/lib/particleos/pcrlock-enrolled
After=local-fs.target systemd-cryptsetup@root.service
Before=boot-complete.target
FailureAction=reboot

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/particleos/pcrlock-enroll

[Install]
RequiredBy=boot-complete.target
