[Unit]
Description=Require healthy rootful Podman workloads before boot blessing
Documentation=https://github.com/thefutureisprivate/particleos-containerhost#workload-health
ConditionPathExists=/sys/firmware/efi/efivars/LoaderBootCountPath-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
After=multi-user.target
Before=systemd-bless-boot.service
FailureAction=reboot

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/particleos/workload-health-gate /usr/lib/particleos/check-workload-health

[Install]
RequiredBy=systemd-bless-boot.service
