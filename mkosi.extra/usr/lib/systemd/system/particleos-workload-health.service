[Unit]
Description=Require healthy rootful Podman workloads before boot blessing
Documentation=https://github.com/thefutureisprivate/particleos-containerhost#workload-health
After=multi-user.target
Before=boot-complete.target
FailureAction=reboot

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/particleos/check-workload-health

[Install]
RequiredBy=boot-complete.target
