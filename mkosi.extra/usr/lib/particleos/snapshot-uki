#!/usr/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# Copy one mutable ESP UKI into a private, stable policy input without adding
# a scripting-language runtime to the host image.
set -euo pipefail

fail() {
    echo "unsafe UKI input: $*" >&2
    exit 1
}

[[ $# -eq 3 ]] || {
    echo "usage: $0 SOURCE DESTINATION_DIRECTORY NAME" >&2
    exit 2
}
source_path=$1
destination=$2
name=$3
maximum_size=$((512 * 1024 * 1024))

[[ $name =~ ^[A-Za-z0-9_.-]+$ && $name != . && $name != .. ]] ||
    fail 'destination name is not a safe basename'
[[ -d $destination && ! -L $destination ]] ||
    fail 'destination is not a real directory'
[[ -f $source_path && ! -L $source_path ]] ||
    fail 'source is not a regular non-symlink file'

# Capture pathname identity around an O_NOFOLLOW copy. A rename, replacement,
# resize, or in-place write changes at least one of these values. The copied
# file is subsequently the sole input to signature, release-identity, digest,
# and PCR-policy operations, so later ESP mutations cannot change admission.
identity_before=$(stat -c '%d:%i:%s:%y:%z' -- "$source_path")
size_before=$(stat -c %s -- "$source_path")
[[ $size_before =~ ^[0-9]+$ && $size_before -ge 1 &&
   $size_before -le $maximum_size ]] || fail 'source size is outside the bound'

output=$destination/$name
[[ ! -e $output && ! -L $output ]] || fail 'destination already exists'
cleanup=1
cleanup_output() {
    local status=$?
    if ((cleanup)) && [[ -f $output && ! -L $output ]]; then
        rm -f -- "$output"
    fi
    exit "$status"
}
trap cleanup_output EXIT
umask 077
set -o noclobber
: >"$output"
set +o noclobber
dd if="$source_path" of="$output" bs=1M iflag=nofollow,fullblock \
    oflag=nofollow conv=notrunc status=none
chmod 0400 "$output"

identity_after=$(stat -c '%d:%i:%s:%y:%z' -- "$source_path")
[[ $identity_before == "$identity_after" ]] ||
    fail 'source changed while being snapshotted'
[[ -f $output && ! -L $output ]] || fail 'snapshot is not a regular file'
size_after=$(stat -c %s -- "$output")
[[ $size_after == "$size_before" ]] || fail 'snapshot size differs from source'
sync -f "$output"
sync -f "$destination"
cleanup=0
