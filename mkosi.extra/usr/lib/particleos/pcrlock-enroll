#!/usr/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail

state=/dev/disk/by-partlabel/ParticleOS-Host-root
state_directory=/var/lib/particleos
marker=$state_directory/pcrlock-enrolled
pending=$state_directory/pcrlock-enrollment-pending
rotated=$state_directory/pcrlock-volume-key-rotated
[[ -b $state && ! -e $marker ]]
install -d -m 0700 "$state_directory"

declare -a pcrlock_tokens=() pcrlock_keyslots=()
declare -a bootstrap_tokens=() bootstrap_keyslots=()
scan_tokens() {
    local id token compact keyslot
    pcrlock_tokens=()
    pcrlock_keyslots=()
    bootstrap_tokens=()
    bootstrap_keyslots=()
    for id in {0..31}; do
        token=$(cryptsetup token export --token-id "$id" "$state" 2>/dev/null) || continue
        compact=${token//[[:space:]]/}
        [[ $compact == *'"type":"systemd-tpm2"'* ]] || continue
        if [[ $compact =~ \"keyslots\":\[\"([0-9]+)\"\] ]]; then
            keyslot=${BASH_REMATCH[1]}
        elif [[ $compact == *'"keyslots":[]'* ]]; then
            keyslot=
        else
            echo "TPM2 token $id has an ambiguous key-slot set" >&2
            return 1
        fi
        if [[ $compact == *'"tpm2_pcrlock":true'* ]]; then
            [[ -n $keyslot ]] || {
                echo "PCR7+11 token $id has no numeric key slot" >&2
                return 1
            }
            pcrlock_tokens+=("$id")
            pcrlock_keyslots+=("$keyslot")
        elif [[ $compact == *'"tpm2-pcrs":[7]'* ]]; then
            bootstrap_tokens+=("$id")
            bootstrap_keyslots+=("$keyslot")
        fi
    done
}

bootstrap_slots_are_live() {
    local keyslot
    [[ ${#bootstrap_tokens[@]} -ge 1 ]]
    for keyslot in "${bootstrap_keyslots[@]}"; do
        [[ -n $keyslot ]] || return 1
    done
}

write_state_file() {
    local destination=$1 temporary
    shift
    temporary=$(mktemp "$state_directory/.${destination##*/}.XXXXXXXX")
    chmod 0600 "$temporary"
    if ! printf '%s\n' "$*" >"$temporary" ||
            ! sync -f "$temporary" || ! mv -- "$temporary" "$destination" ||
            ! sync -f "$state_directory"; then
        rm -f -- "$temporary"
        return 1
    fi
}

enroll_pcrlock() {
    /usr/bin/systemd-cryptenroll \
        --unlock-tpm2-device=auto \
        --tpm2-device=auto \
        --tpm2-pcrs= \
        --tpm2-pcrlock=/var/lib/systemd/pcrlock.json \
        "$state"
}

if [[ ! -e $pending && -e $rotated ]]; then
    read -r rotated_label rotated_boot token_label token_id extra <"$rotated"
    [[ $rotated_label == pcrlock-volume-key-rotated &&
       $rotated_boot =~ ^[0-9a-f-]{36}$ &&
       $token_label == token-id &&
       $token_id =~ ^[0-9]+$ &&
       -z ${extra:-} ]]
    scan_tokens
    [[ ${#pcrlock_tokens[@]} -eq 1 &&
       ${pcrlock_tokens[0]} == "$token_id" &&
       ${#bootstrap_tokens[@]} -eq 0 ]]
    cryptsetup open --type luks2 --test-passphrase --token-only \
        --token-id "$token_id" "$state"
    write_state_file "$marker" \
        "pcrlock-enrolled token-id $token_id volume-key-rotated-boot $rotated_boot"
    echo "PARTICLEOS_PCRLOCK_FINALIZATION_RECOVERED token=$token_id rotated_boot=$rotated_boot"
    exit 0
fi

if [[ ! -e $pending ]]; then
    [[ ! -e $rotated ]]
    /usr/lib/particleos/pcrlock-refresh current
    scan_tokens
    bootstrap_slots_are_live
    if [[ ${#pcrlock_tokens[@]} -eq 0 ]]; then
        enroll_pcrlock
        scan_tokens
    fi
    [[ ${#pcrlock_tokens[@]} -ge 1 ]]
    bootstrap_slots_are_live
    read -r boot_id </proc/sys/kernel/random/boot_id
    write_state_file "$pending" \
        "pcrlock-bootstrap-pending $boot_id token-id ${pcrlock_tokens[0]}"
    echo "PARTICLEOS_PCRLOCK_BOOTSTRAP_STAGED boot=$boot_id token=${pcrlock_tokens[0]}"

    # Queue the reboot before completing this oneshot. The manager accepts the
    # reboot transaction synchronously; returning then lets the start job
    # finish so its shutdown stop job cannot deadlock behind ExecStart. The
    # next boot must prove the exact PCR 7+11 token before any TPM2 enrollment
    # is removed.
    systemctl --no-block reboot
    echo "PARTICLEOS_PCRLOCK_BOOTSTRAP_REBOOT_QUEUED boot=$boot_id"
    exit 0
fi

read -r pending_label previous_boot token_label token_id extra <"$pending"
[[ $pending_label == pcrlock-bootstrap-pending &&
   $previous_boot =~ ^[0-9a-f-]{36}$ &&
   $token_label == token-id &&
   $token_id =~ ^[0-9]+$ &&
   -z ${extra:-} ]]
read -r current_boot </proc/sys/kernel/random/boot_id
[[ $current_boot != "$previous_boot" ]]

token=$(cryptsetup token export --token-id "$token_id" "$state")
compact=${token//[[:space:]]/}
[[ $compact == *'"type":"systemd-tpm2"'* &&
   $compact == *'"tpm2_pcrlock":true'* ]]
cryptsetup open --type luks2 --test-passphrase --token-only \
    --token-id "$token_id" "$state"
echo "PARTICLEOS_PCRLOCK_NEXT_BOOT_PROVED boot=$current_boot token=$token_id"

# The tested token has now unsealed under the next boot's actual PCR 7+11
# state. Rotate the effective volume key while authorizing the operation only
# through that token. A saved bootstrap-era LUKS2 header then wraps an obsolete
# volume key and cannot decrypt the re-encrypted payload.
if [[ ! -e $rotated ]]; then
    /usr/sbin/cryptsetup reencrypt --batch-mode --token-only \
        --token-id "$token_id" "$state"
    write_state_file "$rotated" \
        "pcrlock-volume-key-rotated $current_boot token-id $token_id"
else
    read -r rotated_label rotated_boot token_label rotated_token extra <"$rotated"
    [[ $rotated_label == pcrlock-volume-key-rotated &&
       $rotated_boot =~ ^[0-9a-f-]{36}$ &&
       $token_label == token-id &&
       $rotated_token == "$token_id" &&
       -z ${extra:-} ]]
fi

# cryptsetup reencrypt retires the old key slot but can retain its now-orphaned
# token record. Prove the replacement again, then remove only PCR7 bootstrap
# slots that remain and their exact, already-classified token records.
scan_tokens
[[ ${#pcrlock_tokens[@]} -eq 1 &&
   ${pcrlock_tokens[0]} == "$token_id" ]]
/usr/sbin/cryptsetup open --type luks2 --test-passphrase --token-only \
    --token-id "$token_id" "$state"
for index in "${!bootstrap_tokens[@]}"; do
    bootstrap_token=${bootstrap_tokens[$index]}
    bootstrap_keyslot=${bootstrap_keyslots[$index]}
    if [[ -n $bootstrap_keyslot ]]; then
        [[ $bootstrap_keyslot != "${pcrlock_keyslots[0]}" ]]
        /usr/bin/systemd-cryptenroll --wipe-slot="$bootstrap_keyslot" "$state"
    fi
    if token=$(cryptsetup token export --token-id "$bootstrap_token" "$state" 2>/dev/null); then
        compact=${token//[[:space:]]/}
        [[ $compact == *'"type":"systemd-tpm2"'* &&
           $compact == *'"tpm2-pcrs":[7]'* &&
           $compact == *'"keyslots":[]'* ]]
        cryptsetup token remove --token-id "$bootstrap_token" "$state"
    fi
done
scan_tokens
[[ ${#pcrlock_tokens[@]} -eq 1 &&
   ${pcrlock_tokens[0]} == "$token_id" &&
   ${#bootstrap_tokens[@]} -eq 0 ]]
/usr/sbin/cryptsetup open --type luks2 --test-passphrase --token-only \
    --token-id "$token_id" "$state"
rm -f -- "$pending"
sync -f "$state_directory"
write_state_file "$marker" \
    "pcrlock-enrolled token-id $token_id volume-key-rotated-boot $current_boot"
echo "PARTICLEOS_PCRLOCK_BOOTSTRAP_RETIRED boot=$current_boot token=$token_id"
