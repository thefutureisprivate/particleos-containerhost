#!/usr/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail

marker=/var/lib/particleos/pcrlock-update-ready
policy=/var/lib/systemd/pcrlock.json
receipts=/var/lib/particleos/pcrlock-candidate-attempts

[[ -s $marker && -s $policy ]]
read -r policy_label policy_digest version_label candidate_version \
    uki_label candidate_digest extra <"$marker"
[[ $policy_label == pcrlock-policy-sha256 &&
   $version_label == candidate-version &&
   $uki_label == candidate-uki-sha256 &&
   $policy_digest =~ ^[0-9a-f]{64}$ &&
   $candidate_version =~ ^[0-9]+([.][0-9]+)*$ &&
   $candidate_digest =~ ^[0-9a-f]{64}$ &&
   -z ${extra:-} ]]
[[ $(sha256sum -- "$policy" | cut -d ' ' -f1) == "$policy_digest" ]]

# shellcheck source=/dev/null
source /usr/lib/os-release
[[ ${IMAGE_ID:-} == ParticleOS-Host ]]
[[ ${IMAGE_VERSION:-} =~ ^[0-9]+([.][0-9]+)*$ ]]
if [[ $IMAGE_VERSION == "$candidate_version" ]]; then
    /usr/lib/particleos/pcrlock-refresh current
    echo "PARTICLEOS_PCRLOCK_COMMIT_RECOVERED version=$IMAGE_VERSION"
    exit 0
fi
newest=$(printf '%s\n%s\n' "$IMAGE_VERSION" "$candidate_version" | sort -V | tail -n1)
[[ $newest == "$candidate_version" ]]

declare -A unique_boots=()
[[ -s $receipts ]]
while read -r candidate_label stored_version digest_label stored_digest \
        boot_label stored_boot extra; do
    [[ $candidate_label == candidate-version &&
       $stored_version == "$candidate_version" &&
       $digest_label == candidate-uki-sha256 &&
       $stored_digest == "$candidate_digest" &&
       $boot_label == boot-id &&
       $stored_boot =~ ^[0-9a-f-]{36}$ &&
       -z ${extra:-} ]]
    [[ -z ${unique_boots[$stored_boot]+set} ]]
    unique_boots[$stored_boot]=1
done <"$receipts"
[[ ${#unique_boots[@]} -eq 3 ]]

/usr/lib/particleos/pcrlock-refresh current
echo "PARTICLEOS_PCRLOCK_FALLBACK_PRUNED base=$IMAGE_VERSION candidate=$candidate_version authenticated_attempts=3"
