#!/usr/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail

usage() {
    echo "usage: $0 current|candidate VERSION" >&2
    exit 2
}

[[ $# -ge 1 ]] || usage
mode=$1
case $mode in
    current)
        [[ $# -eq 1 ]] || usage
        ;;
    candidate)
        [[ $# -eq 2 ]] || usage
        candidate_version=$2
        [[ $candidate_version =~ ^[0-9]+([.][0-9]+)*$ ]] || usage
        ;;
    *)
        usage
        ;;
esac

read_release_field() {
    local file=$1 key=$2 value
    value=$(sed -n "s/^${key}=//p" "$file")
    [[ $value != *$'\n'* ]]
    value=${value%\"}
    value=${value#\"}
    [[ $value =~ ^[A-Za-z0-9._-]+$ ]]
    printf '%s\n' "$value"
}

current_version=$(read_release_field /etc/os-release IMAGE_VERSION)
current_image_id=$(read_release_field /etc/os-release IMAGE_ID)
[[ $current_version =~ ^[0-9]+([.][0-9]+)*$ ]]
[[ $current_image_id == ParticleOS-Host ]]
if [[ $mode == candidate ]]; then
    newest=$(printf '%s\n%s\n' "$current_version" "$candidate_version" | sort -V | tail -n1)
    [[ $candidate_version == "$newest" && $candidate_version != "$current_version" ]]
fi

boot_root=$(bootctl --print-boot-path)
boot_root=$(realpath -e -- "$boot_root")
uki_directory="$boot_root/EFI/Linux"
[[ -d $uki_directory && ! -L $uki_directory ]]

current_uki=$(bootctl --print-stub-path)
if [[ ! -e $current_uki && $current_uki =~ ^(.+)\+[0-9]+-[0-9]+\.efi$ ]]; then
    current_uki=${BASH_REMATCH[1]}.efi
fi
current_uki=$(realpath -e -- "$current_uki")
[[ $current_uki == "$uki_directory/"* && -f $current_uki && ! -L $current_uki ]]

declare -a ukis=() digests=()
read_uki_identity() (
    set -euo pipefail
    local uki=$1 scratch image_id image_version
    scratch=$(mktemp -d /run/particleos-uki-identity.XXXXXXXX)
    trap 'rm -rf -- "$scratch"' EXIT

    # GNU objcopy rewrites its input in place when no output operand is given,
    # which strips the Authenticode certificate table from a signed UKI. Always
    # provide a disposable output while dumping the embedded os-release.
    objcopy --dump-section ".osrel=$scratch/osrelease" \
        "$uki" "$scratch/uki.copy" >/dev/null 2>&1
    image_id=$(read_release_field "$scratch/osrelease" IMAGE_ID)
    image_version=$(read_release_field "$scratch/osrelease" IMAGE_VERSION)
    printf '%s %s\n' "$image_id" "$image_version"
)

validate_uki() {
    local uki=$1 expected_version=$2 resolved digest identity image_id image_version extra
    resolved=$(realpath -e -- "$uki")
    [[ $resolved == "$uki_directory/"* && -f $resolved && ! -L $resolved ]]
    [[ $(bootctl kernel-identify "$resolved") == uki ]]
    sbverify --cert /usr/lib/verity.d/_projectcert.crt "$resolved" >/dev/null

    identity=$(read_uki_identity "$resolved")
    read -r image_id image_version extra <<<"$identity"
    [[ -z ${extra:-} ]]
    [[ $image_id == "$current_image_id" && $image_version == "$expected_version" ]]

    digest=$(sha256sum -- "$resolved")
    digest=${digest%% *}
    ukis+=("$resolved")
    digests+=("$digest")
}

validate_uki "$current_uki" "$current_version"

if [[ $mode == candidate ]]; then
    declare -a candidate_ukis=()
    while IFS= read -r -d '' candidate; do
        candidate_name=${candidate##*/}
        if [[ $candidate_name =~ ^ParticleOS-Host_${candidate_version}_x86-64(\+[0-9]+(-[0-9]+)?)?\.efi$ ]]; then
            candidate_ukis+=("$candidate")
        fi
    done < <(find "$uki_directory" -maxdepth 1 -type f \
        -name "ParticleOS-Host_${candidate_version}_x86-64*.efi" -print0)
    [[ ${#candidate_ukis[@]} -eq 1 ]]
    candidate_uki=${candidate_ukis[0]}
    validate_uki "$candidate_uki" "$candidate_version"
    candidate_digest=${digests[1]}
fi

component_parent=/var/lib/pcrlock.d
component="$component_parent/650-particleos-uki.pcrlock.d"
previous="$component_parent/.particleos-uki.previous"
failed="$component_parent/.particleos-uki.failed"
obsolete="$component_parent/750-particleos-uki.pcrlock.d"
obsolete_backup="$component_parent/.particleos-uki.obsolete"
install -d -m 0700 "$component_parent"
[[ ! -e $previous && ! -e $failed && ! -e $obsolete_backup ]]
staging=$(mktemp -d "$component_parent/.particleos-uki.XXXXXXXX")
cleanup() {
    if [[ -n ${staging:-} && -d $staging && $staging == "$component_parent/".particleos-uki.* ]]; then
        find "$staging" -maxdepth 1 -type f -delete
        rmdir "$staging"
    fi
}
trap cleanup EXIT

restore_components() {
    mv -- "$component" "$failed"
    if [[ -d $previous ]]; then
        mv -- "$previous" "$component"
    fi
    if [[ -d $obsolete_backup ]]; then
        mv -- "$obsolete_backup" "$obsolete"
    fi
    find "$failed" -maxdepth 1 -type f -delete
    rmdir "$failed"
}

for index in "${!ukis[@]}"; do
    /usr/lib/systemd/systemd-pcrlock lock-uki "${ukis[$index]}" \
        --pcrlock="$staging/300-${digests[$index]}.pcrlock"
done

# PCR 7 is authorized from the platform's live Secure Boot variables, while
# lock-uki contributes only the booted UKI and an authenticated fresh update
# candidate to PCR 11. No ESP-wide enumeration is used as an authority.
/usr/lib/systemd/systemd-pcrlock lock-secureboot-policy
/usr/lib/systemd/systemd-pcrlock lock-secureboot-authority

# systemd-stub measures the UKI before the built-in 750-enter-initrd
# component. An older development image placed these records at 750, which
# predicted a PCR 11 state that could never unlock on the next boot. Hide that
# invalid component transactionally while replacing it.
if [[ -e $obsolete ]]; then
    [[ -d $obsolete && ! -L $obsolete ]]
    mapfile -d '' unexpected < <(
        find "$obsolete" -mindepth 1 -maxdepth 1 ! -type f -print0
    )
    [[ ${#unexpected[@]} -eq 0 ]]
    mv -- "$obsolete" "$obsolete_backup"
fi

if [[ -d $component ]]; then
    mv -- "$component" "$previous"
fi
mv -- "$staging" "$component"
staging=

# systemd v261 deliberately drops requested PCRs whose event-log state is not
# safe to predict. Preflight the exact machine-readable prediction before
# make-policy mutates the TPM NV index, and refuse any policy that omits either
# side of the rollback boundary.
if ! prediction=$(/usr/lib/systemd/systemd-pcrlock predict \
        --pcr=7 --pcr=11 --json=short); then
    restore_components
    exit 1
fi
prediction_compact=${prediction//[[:space:]]/}
if ! grep -Eq '"pcr":7([,}])' <<<"$prediction_compact" ||
        ! grep -Eq '"pcr":11([,}])' <<<"$prediction_compact"; then
    restore_components
    exit 1
fi

if ! /usr/lib/systemd/systemd-pcrlock make-policy \
        --pcr=7 --pcr=11 --force; then
    restore_components
    exit 1
fi

policy=/var/lib/systemd/pcrlock.json
grep -Eq '"pcr"[[:space:]]*:[[:space:]]*7([,}])' "$policy"
grep -Eq '"pcr"[[:space:]]*:[[:space:]]*11([,}])' "$policy"

if [[ -d $previous ]]; then
    find "$previous" -maxdepth 1 -type f -delete
    rmdir "$previous"
fi
if [[ -d $obsolete_backup ]]; then
    find "$obsolete_backup" -maxdepth 1 -type f -delete
    rmdir "$obsolete_backup"
fi
if [[ $mode == candidate ]]; then
    policy_digest=$(sha256sum -- "$policy")
    policy_digest=${policy_digest%% *}
    printf 'pcrlock-policy-sha256 %s candidate-version %s candidate-uki-sha256 %s\n' \
        "$policy_digest" "$candidate_version" "$candidate_digest" \
        >/var/lib/particleos/pcrlock-update-ready
    chmod 0600 /var/lib/particleos/pcrlock-update-ready
else
    rm -f -- /var/lib/particleos/pcrlock-update-ready
fi
