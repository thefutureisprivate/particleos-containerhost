#!/usr/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -uo pipefail

if (($# == 0)); then
    echo 'workload health gate requires a probe command' >&2
    exit 2
fi

"$@"
probe_status=$?
if ((probe_status == 0)); then
    exit 0
fi

# Leave the candidate unblessed and let systemd-boot consume exactly one of
# the three configured attempts on each reboot. The unit runs only on counted
# candidates, so the uncounted known-good fallback never enters this loop.
sync
echo "PARTICLEOS_WORKLOAD_CANDIDATE_FAILED status=$probe_status" >&2
exit "$probe_status"
