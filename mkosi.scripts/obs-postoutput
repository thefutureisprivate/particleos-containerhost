#!/usr/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail

[[ $(mkosi --version) == 'mkosi 26' ]] || {
    echo "mkosi is not the reviewed stable v26 release" >&2
    exit 1
}
mapfile -t upstream_helpers < <(
    rpm -ql mkosi | grep -E '/mkosi/resources/mkosi-obs/mkosi[.]postoutput$'
)
[[ ${#upstream_helpers[@]} -eq 1 ]] || {
    echo "Cannot locate exactly one packaged mkosi.postoutput helper" >&2
    exit 1
}
upstream_helper=${upstream_helpers[0]}
expected_upstream_helper_digest=2f9616c19b7930e1b32429bccc5ba5a5622f33496da81daadbcab7c9a762c45b
[[ $(rpm -qf --qf '%{NAME}\n' "$upstream_helper") == mkosi &&
   $(sha256sum -- "$upstream_helper" | cut -d ' ' -f1) == "$expected_upstream_helper_digest" ]] || {
    echo "Packaged mkosi.postoutput differs from reviewed upstream v26" >&2
    exit 1
}
build_wrapper=/usr/src/packages/SOURCES/particleos-containerhost/mkosi.scripts/obs-build
archive_helper=/usr/src/packages/SOURCES/particleos-containerhost/mkosi.scripts/repart-archive

[[ -x "$upstream_helper" ]] || {
    echo "Upstream mkosi-obs post-output helper is unavailable" >&2
    exit 1
}
[[ -x "$build_wrapper" ]] || {
    echo "Container-host OBS build wrapper is unavailable" >&2
    exit 1
}
[[ -x "$archive_helper" ]] || {
    echo "Container-host repart archive validator is unavailable" >&2
    exit 1
}

"$upstream_helper" "$@"
install -m0755 "$build_wrapper" "$OUTPUTDIR/particleos-containerhost-obs-build"
install -m0755 "$archive_helper" "$OUTPUTDIR/particleos-containerhost-repart-archive"
wrapper_digest=$(sha256sum -- "$build_wrapper" | awk '{print $1}')
archive_digest=$(sha256sum -- "$archive_helper" | awk '{print $1}')
cat >"$OUTPUTDIR/particleos-containerhost-security-gate" <<EOF
validation=passed
obs_build_sha256=$wrapper_digest
archive_helper_sha256=$archive_digest
EOF
cat >"$OUTPUTDIR/particleos-containerhost-signing.mk" <<'EOF'
.RECIPEPREFIX := >
.PHONY: all
all:
>/usr/bin/bash /work/src/usr/src/packages/SOURCES/particleos-containerhost-obs-build
EOF
cat >>"$OUTPUTDIR/mkosi.conf" <<'EOF'

[Build]
BuildSources=/usr/src/packages/SOURCES:/usr/src/packages/SOURCES
Environment=PARTICLEOS_OBS_SOURCES=/work/src/usr/src/packages/SOURCES
Environment=MAKEFLAGS=--file=/work/src/usr/src/packages/SOURCES/particleos-containerhost-signing.mk

[Content]
BuildScripts=
BuildScripts=/usr/bin/make
EOF
