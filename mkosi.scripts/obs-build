#!/usr/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail

sources=${PARTICLEOS_OBS_SOURCES:-/usr/src/packages/SOURCES}
repository=$sources/particleos-containerhost
signing_wrapper=$sources/particleos-containerhost-obs-build
archive_helper=$sources/particleos-containerhost-repart-archive
gate=$sources/particleos-containerhost-security-gate

gate_fail() {
    echo "Signing-pass security gate failed: $*" >&2
    exit 1
}

if [[ -x $repository/scripts/validate.sh ]]; then
    "$repository/scripts/validate.sh"
elif [[ -f $gate && -f $signing_wrapper && -f $archive_helper ]]; then
    echo "Verifying first-pass security-gate attestation"
    validation_count=$(grep -c '^validation=passed$' "$gate" || true)
    [[ $validation_count == 1 ]] || gate_fail "expected exactly one validation=passed assertion"
    wrapper_digest=$(sed -n 's/^obs_build_sha256=//p' "$gate")
    archive_digest=$(sed -n 's/^archive_helper_sha256=//p' "$gate")
    [[ $wrapper_digest =~ ^[0-9a-f]{64}$ &&
       $archive_digest =~ ^[0-9a-f]{64}$ ]] || gate_fail "malformed attested SHA-256 digest"
    actual_wrapper_digest=$(sha256sum -- "$signing_wrapper" | awk '{print $1}')
    actual_archive_digest=$(sha256sum -- "$archive_helper" | awk '{print $1}')
    [[ $actual_wrapper_digest == "$wrapper_digest" ]] || gate_fail "OBS build wrapper digest mismatch"
    [[ $actual_archive_digest == "$archive_digest" ]] || gate_fail "repart archive validator digest mismatch"
    echo "First-pass security-gate attestation verified"
else
    echo "Repository security validation or its signing-pass attestation is unavailable" >&2
    exit 1
fi

# The detached-signature pass runs in a disposable OBS worker and contains no
# private key material. Trace its local input-selection boundary so a rejected
# handoff is independently diagnosable from the public build log.
if [[ -f $sources/hashes.cpio.rsasign.sig ]]; then
    set -x
fi

[[ $(mkosi --version) == 'mkosi 26' ]] || gate_fail "mkosi is not the reviewed stable v26 release"
mapfile -t upstream_helpers < <(
    rpm -ql mkosi | grep -E '/mkosi/resources/mkosi-obs/mkosi[.]build$'
)
[[ ${#upstream_helpers[@]} -eq 1 ]] || gate_fail "cannot locate exactly one packaged mkosi.build helper"
upstream_helper=${upstream_helpers[0]}
expected_upstream_helper_digest=f5a12b2941b8976239ab08a593a2e75f12d0f2ec981abbce88426cd3019d598d
[[ $(rpm -qf --qf '%{NAME}\n' "$upstream_helper") == mkosi &&
   $(sha256sum -- "$upstream_helper" | cut -d ' ' -f1) == "$expected_upstream_helper_digest" ]] ||
    gate_fail "packaged mkosi.build differs from reviewed upstream v26"
output=/work/src/usr/src/packages/OTHER

[[ -x "$upstream_helper" ]] || {
    echo "Upstream mkosi-obs build helper is unavailable" >&2
    exit 1
}

if [[ ! -f "$sources/hashes.cpio.rsasign.sig" ]]; then
    exec "$upstream_helper" "$@"
fi

scratch="$(mktemp -d /tmp/particleos-obs-sign.XXXXXX)"
trap 'rm -rf -- "$scratch"' EXIT
staged="$scratch/SOURCES"
mkdir "$staged"
for source in "$sources"/*; do
    ln -s -- "$source" "$staged/${source##*/}"
done

shopt -s nullglob
roothashes=("$sources"/ParticleOS-Host_*.roothash)
[[ ${#roothashes[@]} -eq 1 ]] || {
    echo "Expected one ParticleOS host roothash, found ${#roothashes[@]}" >&2
    exit 1
}

prefix="${roothashes[0]%.roothash}"
os_release="$prefix.osrelease"
repart_archive="$prefix.repart.tar"
[[ -f $os_release ]] || gate_fail "missing os-release metadata for the signed root hash"
[[ -f $repart_archive ]] || gate_fail "missing repart archive for the signed root hash"

read_release_field() {
    local key=$1 value
    value="$(sed -n "s/^${key}=//p" "$os_release" | head -n1)"
    value="${value%\"}"
    value="${value#\"}"
    [[ "$value" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
    printf '%s' "$value"
}

image_id="$(read_release_field IMAGE_ID)" || gate_fail "invalid IMAGE_ID in release metadata"
image_version="$(read_release_field IMAGE_VERSION)" || gate_fail "invalid IMAGE_VERSION in release metadata"
label="${image_id}_${image_version}_vsig"
[[ ${#label} -le 36 ]] || {
    echo "GPT label exceeds 36 characters: $label" >&2
    exit 1
}

definitions="$scratch/repart"
[[ -f "$archive_helper" ]] || {
    echo "Hostile-input repart archive validator is unavailable" >&2
    exit 1
}
/usr/bin/python3 "$archive_helper" "$repart_archive" "$definitions"
mapfile -t signature_definitions < <(
    grep -rl '^Type=usr-verity-sig$' "$definitions" --include='*.conf'
)
[[ ${#signature_definitions[@]} -eq 1 ]] || {
    echo "Expected one usr-verity-sig definition" >&2
    exit 1
}
sed -i "s/^Label=.*/Label=$label/" "${signature_definitions[0]}"
grep -qxF "Label=$label" "${signature_definitions[0]}" || gate_fail "cannot set the signed verity partition label"

staged_archive="$staged/${repart_archive##*/}"
rm -- "$staged_archive"
mapfile -t definition_names < <(
    find "$definitions" -maxdepth 1 -type f -name '*.conf' -printf '%f\n' | sort
)
tar --sort=name --mtime="@${SOURCE_DATE_EPOCH:-0}" \
    --owner=0 --group=0 --numeric-owner \
    -cf "$staged_archive" -C "$definitions" "${definition_names[@]}"

patched_helper="$scratch/mkosi.build"
upstream_sources=/usr/src/packages/SOURCES
sed -e "s#^cp -r $upstream_sources/#cp -rL $staged/#" \
    -e "s#$upstream_sources#$staged#g" \
    "$upstream_helper" >"$patched_helper"
grep -qF "cp -rL $staged/" "$patched_helper"
chmod 0755 "$patched_helper"
set +x
"$patched_helper" "$@"

install -m0644 "$staged_archive" "$output/${repart_archive##*/}"
for suffix in manifest.gz osrelease; do
    artifact="$prefix.$suffix"
    [[ -f "$artifact" ]] || {
        echo "Missing release metadata: $artifact" >&2
        exit 1
    }
    install -m0644 "$artifact" "$output/${artifact##*/}"
done

# mkosi's first pass writes SHA256SUMS before OBS injects the signatures. The
# second pass replaces the UKI and raw image, so publish a checksum manifest
# generated only after every final artifact has been staged.
checksum_name="${image_id}_${image_version}_x86-64.SHA256SUMS"
mapfile -d '' actual_artifact_names < <(
    find "$output" -maxdepth 1 -type f \
        -name "${image_id}_${image_version}_x86-64.*" \
        ! -name "$checksum_name" ! -name '*.sha256' ! -name '*.asc' \
        -printf '%f\0' | sort -z
)
artifact_prefix="${image_id}_${image_version}_x86-64"
artifact_names=(
    "$artifact_prefix.efi"
    "$artifact_prefix.esp.raw.zst"
    "$artifact_prefix.manifest.gz"
    "$artifact_prefix.osrelease"
    "$artifact_prefix.raw.zst"
    "$artifact_prefix.repart.tar"
)
for role in usr-x86-64 usr-x86-64-verity usr-x86-64-verity-sig; do
    mapfile -t matches < <(
        find "$output" -maxdepth 1 -type f \
            -name "$artifact_prefix.$role.*.raw.zst" -printf '%f\n'
    )
    [[ ${#matches[@]} -eq 1 &&
       ${matches[0]} =~ ^${artifact_prefix//./[.]}[.]${role}[.][0-9a-f]{32}[.]raw[.]zst$ ]] ||
        gate_fail "expected one canonical $role split artifact"
    artifact_names+=("${matches[0]}")
done
mapfile -t artifact_names < <(printf '%s\n' "${artifact_names[@]}" | sort)
[[ ${#actual_artifact_names[@]} -eq ${#artifact_names[@]} &&
   $(printf '%s\n' "${actual_artifact_names[@]}") == $(printf '%s\n' "${artifact_names[@]}") ]] ||
    gate_fail "final artifact set differs from the exact release schema"
checksum_tmp="$output/.${checksum_name}.tmp"
(
    cd "$output"
    sha256sum -- "${artifact_names[@]}"
) >"$checksum_tmp"
mv -f -- "$checksum_tmp" "$output/$checksum_name"
