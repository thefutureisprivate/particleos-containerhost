from __future__ import annotations

import gzip
import io
import json
import os
from pathlib import Path
import re
import stat
import sys


sys.dont_write_bytecode = True

MAX_COMPRESSED_BYTES = 16 * 1024 * 1024
MAX_MANIFEST_BYTES = 64 * 1024 * 1024
MANIFEST_NAME = re.compile(
    r"ParticleOS-Host_(?P<version>[0-9]+(?:[.][0-9]+){2})_x86-64[.]manifest[.]gz"
)
VERSION = re.compile(r"[0-9A-Za-z.+~^]+-[0-9A-Za-z.+~^]+")
EXPECTED_SYSTEMD_PACKAGES = frozenset(
    {
        "systemd",
        "systemd-boot",
        "systemd-container",
        "systemd-libs",
        "systemd-networkd",
        "systemd-networkd-defaults",
        "systemd-oomd-defaults",
        "systemd-pam",
        "systemd-resolved",
        "systemd-shared",
        "systemd-standalone-sysusers",
        "systemd-udev",
    }
)
REQUIRED_RUNTIME_PACKAGES = frozenset({"podman", "runsc"})


def fail(message: str) -> None:
    raise SystemExit(f"systemd manifest policy: {message}")


def stable_read(path: Path, limit: int) -> bytes:
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        fail(f"cannot open {path}: {error}")

    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode):
            fail(f"{path} is not a regular file")
        if before.st_size > limit:
            fail(f"{path} exceeds its size limit")
        data = bytearray()
        while len(data) <= limit:
            chunk = os.read(descriptor, min(1024 * 1024, limit + 1 - len(data)))
            if not chunk:
                break
            data.extend(chunk)
        after = os.fstat(descriptor)
    finally:
        os.close(descriptor)

    identity = lambda value: (
        value.st_dev,
        value.st_ino,
        value.st_mode,
        value.st_size,
        value.st_mtime_ns,
        value.st_ctime_ns,
    )
    if identity(before) != identity(after) or len(data) != before.st_size:
        fail(f"{path} changed while it was read")
    if len(data) > limit:
        fail(f"{path} exceeds its size limit")
    return bytes(data)


def read_expected_version(source: Path) -> str:
    relative = Path("mkosi.resources") / "systemd-version"
    candidates = (
        source / relative,
        source
        / "usr"
        / "src"
        / "packages"
        / "SOURCES"
        / "particleos-containerhost"
        / relative,
    )
    matches = [path for path in candidates if path.exists() or path.is_symlink()]
    if len(matches) != 1:
        fail(f"expected one reviewed systemd version file, found {len(matches)}")
    path = matches[0]
    try:
        value = stable_read(path, 256).decode("ascii").strip()
    except UnicodeDecodeError:
        fail(f"{path} is not ASCII")
    if VERSION.fullmatch(value) is None:
        fail(f"{path} contains an invalid package version")
    return value


def select_manifest(output: Path) -> Path:
    try:
        matches = [
            Path(entry.path)
            for entry in os.scandir(output)
            if MANIFEST_NAME.fullmatch(entry.name)
        ]
    except OSError as error:
        fail(f"cannot inspect output directory {output}: {error}")
    if len(matches) != 1:
        fail(f"expected exactly one release manifest, found {len(matches)}")
    return matches[0]


def read_manifest(path: Path) -> object:
    compressed = stable_read(path, MAX_COMPRESSED_BYTES)
    try:
        with gzip.GzipFile(fileobj=io.BytesIO(compressed)) as stream:
            payload = stream.read(MAX_MANIFEST_BYTES + 1)
    except (EOFError, OSError) as error:
        fail(f"cannot decompress {path}: {error}")
    if len(payload) > MAX_MANIFEST_BYTES:
        fail(f"decompressed {path} exceeds its size limit")
    try:
        return json.loads(payload)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        fail(f"cannot parse {path}: {error}")


def validate(document: object, expected_version: str, manifest_name: str) -> None:
    expected_keys = {"manifest_version", "config", "packages", "extension"}
    if not isinstance(document, dict) or set(document) != expected_keys:
        fail("top-level manifest schema differs from the reviewed mkosi schema")
    if document["manifest_version"] != 1 or document["extension"] != {}:
        fail("manifest version or extension differs from the reviewed mkosi schema")
    config = document["config"]
    expected_config_keys = {
        "name",
        "distribution",
        "architecture",
        "output_format",
        "version",
        "release",
    }
    if not isinstance(config, dict) or set(config) != expected_config_keys:
        fail("manifest configuration schema differs from the reviewed mkosi schema")
    name_match = MANIFEST_NAME.fullmatch(manifest_name)
    if name_match is None:
        fail("manifest filename differs from the reviewed release schema")
    image_version = name_match.group("version")
    expected_config = {
        "name": "ParticleOS-Host",
        "distribution": "fedora",
        "architecture": "x86-64",
        "output_format": "disk",
        "version": image_version,
        "release": "44",
    }
    if config != expected_config or not image_version.startswith(f"{config['release']}."):
        fail("manifest configuration does not match the selected Fedora release artifact")
    packages = document["packages"]
    if not isinstance(packages, list):
        fail("manifest packages member is not an array")

    versions: dict[str, str] = {}
    for index, package in enumerate(packages):
        if not isinstance(package, dict):
            fail(f"package {index} is not an object")
        if package.get("type") != "rpm":
            continue
        name = package.get("name")
        version = package.get("version")
        architecture = package.get("architecture")
        if not all(isinstance(value, str) and value for value in (name, version, architecture)):
            fail(f"RPM package {index} is malformed")
        if name in versions:
            fail(f"duplicate RPM package {name}")
        versions[name] = version

    systemd_packages = {
        name for name in versions if name == "systemd" or name.startswith("systemd-")
    }
    if systemd_packages != EXPECTED_SYSTEMD_PACKAGES:
        missing = sorted(EXPECTED_SYSTEMD_PACKAGES - systemd_packages)
        extra = sorted(systemd_packages - EXPECTED_SYSTEMD_PACKAGES)
        fail(f"systemd package set differs: missing={missing}, extra={extra}")
    wrong = {
        name: versions[name]
        for name in sorted(systemd_packages)
        if versions[name] != expected_version
    }
    if wrong:
        fail(f"systemd packages differ from {expected_version}: {wrong}")
    missing_runtime = sorted(REQUIRED_RUNTIME_PACKAGES - versions.keys())
    if missing_runtime:
        fail(f"required runtime packages are absent: {missing_runtime}")


def main() -> None:
    source = Path(os.environ.get("SRCDIR", Path(__file__).resolve().parents[1]))
    output_value = os.environ.get("OUTPUTDIR")
    if output_value is None:
        fail("OUTPUTDIR is unset")
    output = Path(output_value)
    expected_version = read_expected_version(source)
    manifest = select_manifest(output)
    validate(read_manifest(manifest), expected_version, manifest.name)
    print(f"Exact systemd package manifest {expected_version} passed: {manifest.name}")


if __name__ == "__main__":
    main()
