#!/usr/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail

readonly username=particleadmin
readonly password='ParticleOS-Test-Run0-261!'
readonly run0_audit=/run/particleos-firstboot-run0-audit

fail() {
    printf 'PARTICLEOS_FIRSTBOOT_CONSOLE_FAIL %s\n' "$*"
    exit 1
}

homectl inspect "$username" >/dev/null 2>&1 || fail 'homed account is absent'
[[ -f /home/$username.home ]] || fail 'LUKS home image is absent'
groups=" $(id --name --groups "$username") "
[[ $groups == *' wheel '* && $groups == *' systemd-journal '* ]] ||
    fail 'administrator groups are incomplete'
identity=$(homectl inspect --json=short "$username")
identity=${identity//[[:space:]]/}
[[ $identity == *'"storage":"luks"'* &&
   $identity == *'"fileSystemType":"btrfs"'* &&
   $identity == *'"diskSize":1073741824'* &&
   $identity == *'"autoResizeMode":"off"'* &&
   $identity == *'"mountNoSuid":true'* &&
   $identity == *'"mountNoDevices":true'* &&
   $identity == *'"mountNoExecute":true'* ]] ||
    fail 'homed identity does not preserve the hardened production properties'

[[ $(readlink -f /etc/localtime) == /usr/share/zoneinfo/Etc/UTC ]] ||
    fail 'timezone was not configured'
grep -q '^root:!unprovisioned:' /etc/shadow &&
    fail 'root recovery password sentinel remains'

PASSWORD="$password" homectl activate "$username" >/dev/null 2>&1 ||
    fail 'homed account activation failed'
home_options=$(findmnt -n -o OPTIONS --target "/home/$username")
home_context=$(stat -c '%C' "/home/$username")
[[ ,$home_options, == *,nosuid,* &&
   ,$home_options, == *,nodev,* &&
   ,$home_options, == *,noexec,* ]] ||
    fail 'home mount flags are not restrictive'
[[ $home_context == system_u:object_r:user_home_t:s0 ]] || {
    printf 'home context=%q\n' "$home_context"
    printf 'home options=%q\n' "$home_options"
    fail 'home root has the wrong SELinux label'
}
printf '%s\n' 'printf "PARTICLEOS_ADMIN_SHELL_READY\\n"' \
    >"/home/$username/.bash_profile"
# The disposable audit account must enter through login(1), PAM, and logind so
# run0 exercises the same active-console authorization path as an administrator.
chown "$username:" "/home/$username/.bash_profile"
chmod 0600 "/home/$username/.bash_profile"
homectl deactivate "$username" >/dev/null 2>&1 || true

cat >"$run0_audit" <<'EOF'
#!/usr/bin/bash
set -euo pipefail

fail() {
    printf 'PARTICLEOS_FIRSTBOOT_CONSOLE_FAIL %s\n' "$*"
    sleep 2
    exit 1
}

[[ $(/usr/bin/id -u) == 0 ]] || fail 'run0 did not enter uid 0'
audit_records=$(/usr/bin/journalctl --boot --no-pager --output=cat \
    _TRANSPORT=audit 2>/dev/null || true)
avc=$(/usr/bin/grep -Ei 'avc:.*denied.*(homed|homework|fsadm|policykit|run0|login)' \
    <<<"$audit_records" || true)
[[ -z $avc ]] || {
    printf '%s\n' "$avc"
    fail 'homed, login, or run0 generated an SELinux denial'
}
authentication=$(/usr/bin/grep -Ei \
    'acct="?particleadmin"?.*(polkit-agent-helper|polkit-1).*(res|result)=success|(polkit-agent-helper|polkit-1).*acct="?particleadmin"?.*(res|result)=success' \
    <<<"$audit_records" || true)
[[ -n $authentication ]] || {
    printf '%s\n' "$audit_records"
    fail 'run0 authentication is absent from the kernel audit trail'
}
printf 'PARTICLEOS_FIRSTBOOT_CONSOLE_PASS user=particleadmin timezone=Etc/UTC run0=authenticated\n'
EOF
chmod 0700 "$run0_audit"

homed_avc=$(journalctl --boot --no-pager --output=cat _TRANSPORT=audit \
    2>/dev/null |
    grep -Ei 'avc:.*denied.*(homed|homework|fsadm|policykit|run0)' || true)
[[ -z $homed_avc ]] || {
    printf '%s\n' "$homed_avc"
    fail 'homed or run0 generated an SELinux denial'
}

printf 'PARTICLEOS_CONSOLE_LOGIN_READY user=%s\n' "$username"
