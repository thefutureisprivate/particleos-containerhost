[Unit]
Description=ParticleOS rollback audit workload-health fault injector
ConditionPathExists=!/etc/initrd-release
ConditionPathExists=/sys/firmware/efi/efivars/LoaderBootCountPath-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
After=multi-user.target
Before=systemd-bless-boot.service
FailureAction=reboot

[Service]
Type=oneshot
RemainAfterExit=yes
LoadCredential=update-rollback-health
LoadCredential=update-audit-scenario
LoadCredential=update-audit-base-version
ExecStart=/usr/bin/bash %d/update-rollback-health
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS0

[Install]
RequiredBy=systemd-bless-boot.service
