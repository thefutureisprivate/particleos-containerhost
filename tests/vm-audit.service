[Unit]
Description=ParticleOS local VM security audit
ConditionPathExists=!/etc/initrd-release
Requires=particleos-pcrlock-enroll.service particleos-workload-health.service
After=multi-user.target particleos-pcrlock-enroll.service particleos-workload-health.service nftables.service particleos-module-lockdown.service systemd-user-sessions.service
SuccessAction=poweroff
FailureAction=poweroff

[Service]
Type=oneshot
LoadCredential=vm-audit
ExecStart=/usr/bin/bash %d/vm-audit
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS0
TimeoutStartSec=3min
