[Transfer]
ProtectVersion=%A
Verify=yes

[Source]
Type=url-file
Path=https://download.opensuse.org/repositories/home:/thefutureisprivate/fedora_44_images/
MatchPattern=%M_@v_%a.usr-%a-verity.@u.raw.zst

[Target]
Type=partition
Path=auto
MatchPattern=%M_@v_verity
MatchPartitionType=usr-verity
PartitionFlags=0
ReadOnly=1
